{
  "properties": {
    "connectionReferences": {
      "shared_mtc-20microsoft-20graph-20mail-5fad2197ce913463-bbf4bc2ad08b7a26": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "mtc_MTCGraphMail"
        },
        "api": {
          "name": "shared_mtc-20microsoft-20graph-20mail-5fad2197ce913463-bbf4bc2ad08b7a26",
          "logicalName": "mtc_mtc-20microsoft-20graph-20mail"
        }
      },
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "mtc_MTCMicrosoftDataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Minute",
            "interval": 3
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Initialize_runtime_variables": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "NextPageUrl",
                "type": "string",
                "value": ""
              },
              {
                "name": "PageFailed",
                "type": "boolean",
                "value": false
              },
              {
                "name": "PollLease",
                "type": "string",
                "value": "00000000-0000-0000-0000-000000000000"
              },
              {
                "name": "AnyMailboxFailed",
                "type": "boolean",
                "value": false
              },
              {
                "name": "MessagesAssessed",
                "type": "integer",
                "value": 0
              },
              {
                "name": "FailedMailboxes",
                "type": "string",
                "value": ""
              }
            ]
          }
        },
        "List_enrolled_mailboxes": {
          "runAfter": {
            "Initialize_runtime_variables": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "mtc_mailboxenrollments",
              "$select": "mtc_mailboxenrollmentid,mtc_mailboxreference",
              "$filter": "mtc_enrollmentstatus eq 100000001 and statecode eq 0",
              "$top": 500
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "connectionName": "shared_commondataserviceforapps"
            },
            "retryPolicy": {
              "type": "exponential",
              "count": 4,
              "interval": "PT10S",
              "minimumInterval": "PT5S",
              "maximumInterval": "PT2M"
            }
          }
        },
        "For_each_enrolled_mailbox": {
          "runAfter": {
            "List_enrolled_mailboxes": [
              "Succeeded"
            ]
          },
          "type": "Foreach",
          "foreach": "@body('List_enrolled_mailboxes')?['value']",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "actions": {
            "Process_mailbox": {
              "type": "Scope",
              "actions": {
                "Reset_poll_lease": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "PollLease",
                    "value": "00000000-0000-0000-0000-000000000000"
                  }
                },
                "Reset_page_failure": {
                  "runAfter": {
                    "Reset_poll_lease": [
                      "Succeeded"
                    ]
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "PageFailed",
                    "value": false
                  }
                },
                "Begin_mailbox_poll": {
                  "runAfter": {
                    "Reset_page_failure": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "actionName": "mtc_BeginMailboxPoll",
                      "item/MailboxRecordId": "@items('For_each_enrolled_mailbox')?['mtc_mailboxenrollmentid']"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "PerformUnboundAction",
                      "connectionName": "shared_commondataserviceforapps"
                    },
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 4,
                      "interval": "PT10S",
                      "minimumInterval": "PT5S",
                      "maximumInterval": "PT2M"
                    }
                  }
                },
                "Require_enabled_shadow_mailbox": {
                  "runAfter": {
                    "Begin_mailbox_poll": [
                      "Succeeded"
                    ]
                  },
                  "type": "If",
                  "expression": {
                    "equals": [
                      "@body('Begin_mailbox_poll')?['Enabled']",
                      true
                    ]
                  },
                  "actions": {
                    "Set_poll_lease": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "PollLease",
                        "value": "@body('Begin_mailbox_poll')?['LeaseId']"
                      }
                    },
                    "Set_initial_page_url": {
                      "runAfter": {
                        "Set_poll_lease": [
                          "Succeeded"
                        ]
                      },
                      "type": "SetVariable",
                      "inputs": {
                        "name": "NextPageUrl",
                        "value": "@body('Begin_mailbox_poll')?['NextPageUrl']"
                      }
                    },
                    "Process_all_message_pages": {
                      "runAfter": {
                        "Set_initial_page_url": [
                          "Succeeded"
                        ]
                      },
                      "type": "Until",
                      "expression": "@or(equals(variables('NextPageUrl'), ''), equals(variables('PageFailed'), true))",
                      "limit": {
                        "count": 1000,
                        "timeout": "PT6H"
                      },
                      "actions": {
                        "Process_one_page": {
                          "type": "Scope",
                          "actions": {
                            "List_metadata_page": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "mailbox": "@body('Begin_mailbox_poll')?['MailboxReference']",
                                  "$filter": "@concat('receivedDateTime ge ', formatDateTime(body('Begin_mailbox_poll')?['ScanFrom'], 'yyyy-MM-ddTHH:mm:ssZ'), ' and receivedDateTime lt ', formatDateTime(body('Begin_mailbox_poll')?['ScanUntil'], 'yyyy-MM-ddTHH:mm:ssZ'))",
                                  "$select": "id,parentFolderId,receivedDateTime,from,sender,replyTo,categories,internetMessageHeaders",
                                  "$top": 50,
                                  "Prefer": "IdType=\"ImmutableId\"",
                                  "x-mtc-page-url": "@variables('NextPageUrl')"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_mtc-20microsoft-20graph-20mail-5fad2197ce913463-bbf4bc2ad08b7a26",
                                  "operationId": "ListMailboxMessages",
                                  "connectionName": "shared_mtc-20microsoft-20graph-20mail-5fad2197ce913463-bbf4bc2ad08b7a26"
                                },
                                "retryPolicy": {
                                  "type": "exponential",
                                  "count": 4,
                                  "interval": "PT10S",
                                  "minimumInterval": "PT5S",
                                  "maximumInterval": "PT2M"
                                }
                              }
                            },
                            "Assess_shadow_batch": {
                              "runAfter": {
                                "List_metadata_page": [
                                  "Succeeded"
                                ]
                              },
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "actionName": "mtc_ProcessMessageBatch",
                                  "item/MailboxRecordId": "@items('For_each_enrolled_mailbox')?['mtc_mailboxenrollmentid']",
                                  "item/LeaseId": "@variables('PollLease')",
                                  "item/MessagesJson": "@string(body('List_metadata_page')?['value'])",
                                  "item/ImmutableIdsApplied": "@contains(toLower(replace(coalesce(outputs('List_metadata_page')?['headers']?['preference-applied'], outputs('List_metadata_page')?['headers']?['Preference-Applied'], ''), '\"', '')), 'idtype=immutableid')"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                  "operationId": "PerformUnboundAction",
                                  "connectionName": "shared_commondataserviceforapps"
                                },
                                "retryPolicy": {
                                  "type": "exponential",
                                  "count": 4,
                                  "interval": "PT10S",
                                  "minimumInterval": "PT5S",
                                  "maximumInterval": "PT2M"
                                }
                              }
                            },
                            "Count_assessed_messages": {
                              "runAfter": {
                                "Assess_shadow_batch": [
                                  "Succeeded"
                                ]
                              },
                              "type": "IncrementVariable",
                              "inputs": {
                                "name": "MessagesAssessed",
                                "value": "@coalesce(body('Assess_shadow_batch')?['ProcessedCount'], 0)"
                              }
                            },
                            "Set_next_graph_page": {
                              "runAfter": {
                                "Count_assessed_messages": [
                                  "Succeeded"
                                ]
                              },
                              "type": "SetVariable",
                              "inputs": {
                                "name": "NextPageUrl",
                                "value": "@coalesce(body('List_metadata_page')?['@odata.nextLink'], '')"
                              }
                            },
                            "Complete_successful_page": {
                              "runAfter": {
                                "Set_next_graph_page": [
                                  "Succeeded"
                                ]
                              },
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "actionName": "mtc_CompleteMailboxPage",
                                  "item/MailboxRecordId": "@items('For_each_enrolled_mailbox')?['mtc_mailboxenrollmentid']",
                                  "item/LeaseId": "@variables('PollLease')",
                                  "item/NextPageUrl": "@variables('NextPageUrl')"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                  "operationId": "PerformUnboundAction",
                                  "connectionName": "shared_commondataserviceforapps"
                                },
                                "retryPolicy": {
                                  "type": "exponential",
                                  "count": 4,
                                  "interval": "PT10S",
                                  "minimumInterval": "PT5S",
                                  "maximumInterval": "PT2M"
                                }
                              }
                            }
                          }
                        },
                        "Stop_on_page_failure": {
                          "runAfter": {
                            "Process_one_page": [
                              "Failed",
                              "TimedOut"
                            ]
                          },
                          "type": "SetVariable",
                          "inputs": {
                            "name": "PageFailed",
                            "value": true
                          }
                        }
                      }
                    },
                    "Require_successful_page_loop": {
                      "runAfter": {
                        "Process_all_message_pages": [
                          "Succeeded"
                        ]
                      },
                      "type": "If",
                      "expression": {
                        "equals": [
                          "@variables('PageFailed')",
                          true
                        ]
                      },
                      "actions": {
                        "Mark_page_failure": {
                          "type": "SetVariable",
                          "inputs": {
                            "name": "AnyMailboxFailed",
                            "value": true
                          }
                        },
                        "Record_failed_page_mailbox": {
                          "runAfter": {
                            "Mark_page_failure": [
                              "Succeeded"
                            ]
                          },
                          "type": "AppendToStringVariable",
                          "inputs": {
                            "name": "FailedMailboxes",
                            "value": "@{items('For_each_enrolled_mailbox')?['mtc_mailboxreference']} "
                          }
                        },
                        "Notify_page_failure": {
                          "runAfter": {
                            "Record_failed_page_mailbox": [
                              "Succeeded"
                            ]
                          },
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "actionName": "mtc_ReportMailboxFailure",
                              "item/MailboxRecordId": "@items('For_each_enrolled_mailbox')?['mtc_mailboxenrollmentid']",
                              "item/LeaseId": "@variables('PollLease')",
                              "item/Reason": "A Graph page or metadata assessment failed. The unfinished cursor was preserved; inspect the run before retrying."
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                              "operationId": "PerformUnboundAction",
                              "connectionName": "shared_commondataserviceforapps"
                            },
                            "retryPolicy": {
                              "type": "exponential",
                              "count": 4,
                              "interval": "PT10S",
                              "minimumInterval": "PT5S",
                              "maximumInterval": "PT2M"
                            }
                          }
                        }
                      },
                      "else": {
                        "actions": {}
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              }
            },
            "Mark_any_mailbox_failed": {
              "runAfter": {
                "Process_mailbox": [
                  "Failed",
                  "TimedOut"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "AnyMailboxFailed",
                "value": true
              }
            },
            "Record_failed_mailbox": {
              "runAfter": {
                "Mark_any_mailbox_failed": [
                  "Succeeded"
                ]
              },
              "type": "AppendToStringVariable",
              "inputs": {
                "name": "FailedMailboxes",
                "value": "@{items('For_each_enrolled_mailbox')?['mtc_mailboxreference']} "
              }
            },
            "Notify_mailbox_failure": {
              "runAfter": {
                "Record_failed_mailbox": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "actionName": "mtc_ReportMailboxFailure",
                  "item/MailboxRecordId": "@items('For_each_enrolled_mailbox')?['mtc_mailboxenrollmentid']",
                  "item/LeaseId": "@variables('PollLease')",
                  "item/Reason": "Shadow processing failed. Inspect the Power Automate run; the delivery checkpoint was not advanced."
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "PerformUnboundAction",
                  "connectionName": "shared_commondataserviceforapps"
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S",
                  "minimumInterval": "PT5S",
                  "maximumInterval": "PT2M"
                }
              }
            }
          }
        },
        "Record_run_log": {
          "runAfter": {
            "For_each_enrolled_mailbox": [
              "Succeeded",
              "Failed",
              "TimedOut",
              "Skipped"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "mtc_runlogs",
              "item/mtc_name": "@concat('Shadow check ', utcNow())",
              "item/mtc_worker": "Shadow check",
              "item/mtc_runid": "@workflow()?['run']?['name']",
              "item/mtc_startedon": "@trigger()?['startTime']",
              "item/mtc_endedon": "@utcNow()",
              "item/mtc_outcome": "@if(variables('AnyMailboxFailed'), 100000002, 100000001)",
              "item/mtc_itemsprocessed": "@variables('MessagesAssessed')",
              "item/mtc_failures": "@if(variables('AnyMailboxFailed'), max(1, length(split(trim(variables('FailedMailboxes')), ' '))), 0)",
              "item/mtc_details": "@concat('Enrolled mailboxes: ', length(coalesce(body('List_enrolled_mailboxes')?['value'], json('[]'))), '. Messages assessed: ', variables('MessagesAssessed'), '. Failed mailboxes: ', if(empty(trim(variables('FailedMailboxes'))), 'none', trim(variables('FailedMailboxes'))), '.')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "CreateRecord",
              "connectionName": "shared_commondataserviceforapps"
            },
            "retryPolicy": {
              "type": "exponential",
              "count": 4,
              "interval": "PT10S",
              "minimumInterval": "PT5S",
              "maximumInterval": "PT2M"
            }
          }
        },
        "Require_all_mailboxes_succeeded": {
          "runAfter": {
            "Record_run_log": [
              "Succeeded",
              "Failed",
              "TimedOut"
            ]
          },
          "type": "If",
          "expression": {
            "equals": [
              "@variables('AnyMailboxFailed')",
              true
            ]
          },
          "actions": {
            "Fail_run_with_operator_notifications": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "MTC_MAILBOX_PROCESSING_FAILED",
                  "message": "One or more mailboxes failed. In-app notifications and mailbox health identify the affected scope."
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}